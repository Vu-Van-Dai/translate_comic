{
  "manifest_version": 3,
  "name": "Comic Chapter Capture",
  "version": "0.1.0",
  "description": "Collect a chapter's pages from the reader you are viewing, into a folder the comic-translator pipeline can ingest.",
  "permissions": ["activeTab", "scripting", "downloads", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Comic Chapter Capture",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
